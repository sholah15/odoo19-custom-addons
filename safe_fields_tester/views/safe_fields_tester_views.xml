<odoo>

    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="safe_fields_tester_list">
      <field name="name">safe.fields.tester.list</field>
      <field name="model">safe.fields.tester</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="notes"/>
          <field name="distance" widget="safe_float"/>
          <field name="qty" widget="safe_integer"/>
          <field name="price" widget="safe_monetary" options="{'currency_field': 'currency_id'}"/>
          <field name="currency_id"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="safe_fields_tester_form">
      <field name="name">safe.fields.tester.form</field>
      <field name="model">safe.fields.tester</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="notes"/>
                    <field name="distance" widget="safe_float"/>
                </group>
                <group>
                    <field name="qty" widget="safe_integer"/>
                    <field name="price" widget="safe_monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id"/>
                </group>
            </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="safe_fields_tester_action">
      <field name="name">Safe Fields Tester</field>
      <field name="res_model">safe.fields.tester</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- Top menu item -->
    <menuitem name="Safe Fields Tester" id="safe_fields_tester_menu_root"/>
    <!-- menu categories -->
    <menuitem name="Safe Fields Tester" id="safe_fields_tester_menu_1" parent="safe_fields_tester_menu_root"/>
    <!-- actions -->
    <menuitem name="List" id="safe_fields_tester_menu_1_list" parent="safe_fields_tester_menu_1"
              action="safe_fields_tester_action"/>


</odoo>